# Telegram
BOT_TOKEN=123456:ABC-DEF...
ADMIN_CHAT_ID=123456789

# Мониторинг
# POLL_INTERVAL — секунд между циклами опроса, не меньше 20
POLL_INTERVAL=45
TRACK_URLS=https://somon.tj/nedvizhimost/arenda-kvartir/dushanbe/
MAX_PAGES=1
REQUEST_TIMEOUT=15
# PROXY_URL — опционально: socks5://user:pass@host:port
PROXY_URL=

# Фильтры по умолчанию (можно менять командами бота)
PRICE_MIN=2000
PRICE_MAX=7000
ROOMS=1,2,3
AREA_MIN=40
AREA_MAX=
FLOOR_MIN=2
FLOOR_MAX=12
DISTRICTS_INCLUDE=
DISTRICTS_EXCLUDE=
KEYWORDS_EXCLUDE=посуточно,суточно,на сутки,комната,койко,хостел,общежитие
ONLY_WITH_PHOTO=true
SKIP_PROMOTED=true

# Прочее
DB_PATH=./data/bot.db
LOG_LEVEL=INFO
TZ=Asia/Dushanbe
